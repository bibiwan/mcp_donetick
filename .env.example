# DoneTick Server URL (internal Docker network or external URL)
DONETICK_URL=http://donetick:2021

# Default DoneTick API Token / Access Token (optional if passed via client Bearer token)
DONETICK_TOKEN=your_donetick_api_token_here

# MCP Server Port & Host
PORT=3000
HOST=0.0.0.0

# Optional MCP Bearer authentication token for protecting the MCP endpoint
MCP_AUTH_TOKEN=your_custom_mcp_auth_token_here

# Timezone used to resolve dates given without an explicit UTC offset,
# e.g. "2026-08-30" or "2026-08-30 09:15". Defaults to UTC.
DONETICK_TIMEZONE=Europe/Paris

# Time of day applied to date-only due dates. Defaults to 18:00.
DONETICK_DEFAULT_DUE_TIME=18:00

# Log level (debug, info, warn, error)
LOG_LEVEL=info
